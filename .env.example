# ============================================================================
# Equastore v2 — Environment Configuration
# ============================================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.

# --- Database ---
# Local dev: PostgreSQL (Docker or local install)
# Production: Vercel Postgres or Neon (recommended)
DATABASE_URL="postgresql://equastore:equastore@localhost:5432/equastore_v2?schema=public"

# --- NextAuth (hybrid guest/auth) ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-32-byte-random"
NEXTAUTH_URL="http://localhost:3000"

# --- Dropi API tokens (per country) ---
# Get these from your Dropi dashboard: https://app.dropi.{country}/settings/api
DROPI_EC_API_URL="https://api.dropi.ec/api/v1"
DROPI_EC_TOKEN="replace-with-ec-token"

DROPI_CO_API_URL="https://api.dropi.co/api/v1"
DROPI_CO_TOKEN="replace-with-co-token"

DROPI_MX_API_URL="https://api.dropi.mx/api/v1"
DROPI_MX_TOKEN="replace-with-mx-token"

DROPI_CL_API_URL="https://api.dropi.cl/api/v1"
DROPI_CL_TOKEN="replace-with-cl-token"

DROPI_PE_API_URL="https://api.dropi.pe/api/v1"
DROPI_PE_TOKEN="replace-with-pe-token"

# --- dLocal payment gateway ---
# Get these from https://dlocal.com/signup (2-3 day review)
DLOCAL_X_LOGIN="replace-with-dlocal-x-login"
DLOCAL_X_TRANS_KEY="replace-with-dlocal-x-trans-key"
DLOCAL_X_SECRET="replace-with-dlocal-secret"
DLOCAL_API_BASE="https://api.dlocal.com"
DLOCAL_SANDBOX_API_BASE="https://sandbox.dlocal.com"
DLOCAL_SANDBOX="true" # set to "false" for production

# --- BTCPay Server (crypto payments) ---
# Self-hosted: https://btcpayserver.org/ (8h setup)
# Or use a hosted instance
BTCPAY_SERVER_URL="https://btcpay.yourdomain.com"
BTCPAY_STORE_ID="replace-with-btcpay-store-id"
BTCPAY_API_KEY="replace-with-btcpay-api-key"

# --- Cloudflare geolocation (middleware) ---
# Cloudflare adds this header automatically when proxying
# https://developers.cloudflare.com/fundamentals/reference/http-request-headers/#cf-ipcountry
CLOUDFLARE_IPCOUNTRY_HEADER="cf-ipcountry"
# Fallback when not behind Cloudflare (dev)
GEO_FALLBACK_COUNTRY="EC"

# --- n8n webhook (Google Sheets + WhatsApp automation) ---
N8N_WEBHOOK_URL="https://n8n.yourdomain.com/webhook/equastore-orders"

# --- WhatsApp Business API (optional, for COD confirmation) ---
WHATSAPP_API_URL="https://graph.facebook.com/v18.0"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

# --- Site URL ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Equastore"
