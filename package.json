{
  "name": "equastore-v2",
  "version": "0.1.0",
  "private": true,
  "description": "Equastore v2 — multi-country dropshipping (Dropi EC/CO/MX/CL/PE) with dLocal payments, COD, and AI-powered checkout. Built with Next.js 16 + Prisma + Tailwind + shadcn/ui.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:gh": "GITHUB_PAGES=true next build",
    "deploy:gh": "npm run build:gh && touch out/.nojekyll && gh-pages -t -d out",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hey-api/client-fetch": "^0.7.0",
    "@prisma/client": "^6.0.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tabler/icons-react": "^3.50.0",
    "@tsparticles/engine": "^4.5.3",
    "@tsparticles/react": "^4.5.3",
    "@tsparticles/slim": "^4.5.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^0.460.0",
    "motion": "^14.10.1",
    "next": "16.4.5",
    "next-auth": "^5.0.0-beta.25",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-tsparticles": "^2.12.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.5.5",
    "three": "^0.187.0",
    "tsparticles": "^4.5.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "gh-pages": "^6.3.0",
    "prisma": "^6.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
